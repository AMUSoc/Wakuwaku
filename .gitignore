# Rust build output, and the schemas tauri-build generates
src-tauri/target/
src-tauri/gen/

# Her settings, pets and logs when run from source (see src-tauri/src/data.rs).
data/*
# Except the pets made here, finished (tools/slice_sheet.py).
!data/pets/
data/pets/*
!data/pets/grok-chan/
!data/pets/gpt-astra/
# A test copy's data folder (WAKUWAKU_USER_DATA=data2)
data2/

# Downloaded pets are their authors' work
pets/*
!pets/.gitkeep
# Except the default pet, carried in the exe (fetch.rs seed_default_pet).
!pets/claude-chan/

# Left from the Electron build, if still around locally
node_modules/
dist/
out/

*.log
.DS_Store
Thumbs.db

# Art and research stay local: others' characters, fan art, references.
# Only the note about them goes in (see art/README.md).
art/*
!art/README.md
# Except the sheets and previews of the pets made here (art/README.md).
!art/grok/
!art/astra/

# The Thunderbird extension, packed (integrations/thunderbird/build.ps1)
integrations/thunderbird/*.xpi

# Hook requests written down by tools/hook_dump.py
tools/dumps/

# tools/slice_sheet.py's frames, made again from the pose sheet; Python's cache
tools/*-frames/
__pycache__/
